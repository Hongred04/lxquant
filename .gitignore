# ============ 不进的：能再生成的 & 本机私有的 ============

# 自带的 Python 运行时（100MB，换机器重新放一份就行）
runtime/

# 行情缓存（一天一个文件，累计 500MB 以上，删了会自动重新下）
data/cache/

# 导出的 csv / json（每次点「导出」都会再生成一个）
data/export/

# 上次选股结果（每次跑完都覆盖，属于运行态）
data/last_screen.json

# 自选股名单（本机私有）
data/watchlist.json

# 选股记忆（本机积累的回看记录，换机器重新开始攒）
data/memory/

# 收益曲线的模拟结果（跑一次十几秒，换机器重新跑一遍就行）
data/equity.json

# 避雷打分的全市场百分位（每天重算一次，51 KB，随行情变，不该进仓库）
data/avoid.json

# 删掉的功能留下的人工数据（隔夜低吸账本等），留着可查，不进仓库
data/backup/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 编辑器和系统文件
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# 修 index.html 编码事故时留下的中间产物
web/_backup/

# 运行时日志
*.log
_srv.err
_server_log.txt

# 前端压缩产物（由 tools/build.js 生成，可随时重建；提交它们是为了
# 直接双击运行不带 node 的机器也能吃到压缩版，见 README「构建」一节）
# web/app.min.js
# web/style.min.css

# ============ 安卓：构建产物与二进制 ============

# APK 产物（一个 38MB，随时能重打）
# 中间产物（classes、对齐前后的包、解包出来的 py/）
# Python 代码包与标准库 pyc（pack_py.py 重新生成；标准库那份需要 CPython 3.12 才能编）
# 签名密钥：本机私有，绝不进仓库

# 隔离目录：删掉的旧策略 / 旧策略产生的记忆记录，留作本地备查，不进仓库
data/*_quarantine/

# 临时图标（没有代码引用）
股票.ico

# 大金融板块：运行时缓存与研究中间产物
# （fin_history.json 是产品数据，要进仓；其余不进）
data/fin_state.json
data/fin_list.pkl
data/long/
data/long_all.pkl
result_*.json

# 用户持仓（私有，换机器不带走）
data/fin_pos.json
# 上证长历史（东财 8756 根，可重抓）
data/idx_long.pkl
